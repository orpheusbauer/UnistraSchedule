{
  "manifest_version": 3,
  "name": "Unistra Schedule",
  "version": "1.0.4",
  "description": "Masquez des cours et ajoutez vos événements personnels à l’emploi du temps Unistra.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://monemploidutemps.unistra.fr/*",
    "https://monedt.unistra.fr/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "unistra-schedule@orpheusbauer.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Personnaliser mon emploi du temps",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://monemploidutemps.unistra.fr/*",
        "https://monedt.unistra.fr/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
